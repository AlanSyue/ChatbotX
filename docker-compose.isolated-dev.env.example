# Docker Compose project and isolated host ports.
COMPOSE_PROJECT_NAME=chatbotx-dev
DEV_POSTGRES_PORT=55432
DEV_ADMINER_PORT=58080
DEV_SMTP_PORT=51025
DEV_MAILHOG_PORT=58025
DEV_S3_PORT=59000
DEV_S3_CONSOLE_PORT=59001
DEV_REDIS_PORT=56379
DEV_REDIS_UI_PORT=55540

# Development-only infrastructure credentials.
# Replace these values in the untracked local copy before starting the stack.
DEV_POSTGRES_DB=chatbotx_dev
DEV_POSTGRES_USER=chatbotx_dev
DEV_POSTGRES_PASSWORD=development-only-secret
DEV_RUSTFS_ACCESS_KEY=chatbotx-dev
DEV_RUSTFS_SECRET_KEY=development-only-secret
DEV_RUSTFS_CORS_ORIGIN=http://127.0.0.1:3123
DEV_S3_BUCKET=chatbotx-dev

# Application variables for the future isolated dev launcher.
# Production integration credentials are intentionally not included.
NEXT_PUBLIC_EDITION=community
BETTER_AUTH_SECRET=ZGV2ZWxvcG1lbnQtb25seS1jaGF0Ym90eC1rZXktMDE=
BETTER_AUTH_URL=http://127.0.0.1:3123
ENCRYPTION_KEY=1111111111111111111111111111111111111111111111111111111111111111
DATABASE_URL=postgresql://chatbotx_dev:development-only-secret@127.0.0.1:55432/chatbotx_dev?schema=public
REDIS_URL=redis://127.0.0.1:56379
REDIS_CACHE_URL=redis://127.0.0.1:56379
REDIS_QUEUE_URL=redis://127.0.0.1:56379
REDIS_SEQUENCE_URL=redis://127.0.0.1:56379
S3_ACCESS_KEY_ID=chatbotx-dev
S3_SECRET_ACCESS_KEY=development-only-secret
S3_BUCKET=chatbotx-dev
S3_REGION=us-west-2
S3_ENDPOINT=http://127.0.0.1:59000
SMTP_SERVER=smtp://127.0.0.1:51025
SMTP_FROM=no-reply@localhost
REALTIME_BROADCAST_SECRET=development-only-realtime-secret
NEXT_PUBLIC_BUILDER_URL=http://127.0.0.1:3123
NEXT_PUBLIC_INTERNAL_STORAGE_URL=http://127.0.0.1:59000/chatbotx-dev/
NEXT_PUBLIC_INTERNAL_WS_URL=http://127.0.0.1:1999
